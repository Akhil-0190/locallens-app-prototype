rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // -----------------------------------------------------------------------
    // Helper functions
    // -----------------------------------------------------------------------

    /** True when the request comes from an authenticated user. */
    function isAuthenticated() {
      return request.auth != null;
    }

    /** True when the requesting user owns the given userId value. */
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    /** True when the requesting user has MODERATOR or ADMIN role.
        Role is stored on the user's profile document and read via get(). */
    function isModerator() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role
          in ['MODERATOR', 'ADMIN'];
    }

    /** True when the existing document's contributorId matches the authenticated UID. */
    function isContributionOwner(contributionData) {
      return isAuthenticated() &&
        contributionData.submission.contributorId == request.auth.uid;
    }

    // -----------------------------------------------------------------------
    // users/{userId}
    // -----------------------------------------------------------------------
    // - Owner: read and update own profile (except role field).
    // - Role changes: Admin SDK only (backend enforces this in service layer).
    // - Moderators/Admins: may read any profile (for moderation UI).
    // - Create/Delete: Admin SDK only.
    // -----------------------------------------------------------------------

    match /users/{userId} {
      allow read: if isOwner(userId) || isModerator();

      // Owner may update own profile but CANNOT change their own role field.
      allow update: if isOwner(userId)
        && request.resource.data.role == resource.data.role;

      // Only Admin SDK creates/deletes user documents.
      allow create: if false;
      allow delete: if false;
    }

    // -----------------------------------------------------------------------
    // preferences/{userId} (Domain 02 Canonical Storage)
    // -----------------------------------------------------------------------
    // - Read: Owner of preferences.
    // - Write: STRICTLY DENIED for direct client writes (allow write: if false).
    //          All preference modifications MUST go through the updatePreferences
    //          Cloud Function to guarantee Zod schema validation, bounds checking,
    //          and timestamp normalization.
    // -----------------------------------------------------------------------

    match /preferences/{userId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // Legacy subcollection path compatibility (read-only for owner)
    match /users/{userId}/preferences/{prefDoc} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    // -----------------------------------------------------------------------
    // group_sessions/{sessionId} (Domain 09 Groups & Taste Matching)
    // -----------------------------------------------------------------------
    // - Read: Host or members listed in resource.data.memberUserIds.
    //         (Note: resource.data.members is an array of maps; Firestore rules
    //          requires a simple string array memberUserIds to test membership).
    // - Write: Admin SDK only via Cloud Functions (enforces short codes,
    //          Zod schema validation, and state machine transitions).
    // -----------------------------------------------------------------------

    match /group_sessions/{sessionId} {
      allow read: if isAuthenticated() && (
        resource.data.hostUserId == request.auth.uid ||
        request.auth.uid in resource.data.memberUserIds
      );
      allow create, update, delete: if false;
    }

    // -----------------------------------------------------------------------
    // places/{placeId}/hourly_capacities/{slotId} (Domain 07 Venue Capacity)
    // -----------------------------------------------------------------------
    // - Read: Any authenticated user (to render live crowd badge indicators).
    // - Write: Admin SDK only via Cloud Functions transactions.
    // -----------------------------------------------------------------------

    match /places/{placeId}/hourly_capacities/{slotId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if false;
    }

    // -----------------------------------------------------------------------
    // scheduled_visits/{visitId} (Domain 07 Scheduled Visits)
    // -----------------------------------------------------------------------
    // - Read: Booking traveler, member in memberUserIds, or moderator/admin.
    // - Write: Admin SDK only via bookScheduledVisit / cancelScheduledVisit.
    // -----------------------------------------------------------------------

    match /scheduled_visits/{visitId} {
      allow read: if isAuthenticated() && (
        resource.data.travelerId == request.auth.uid ||
        request.auth.uid in resource.data.memberUserIds ||
        isModerator()
      );
      allow create, update, delete: if false;
    }


    // -----------------------------------------------------------------------
    // contributions/{contributionId}
    // -----------------------------------------------------------------------
    // - Create: STRICTLY DENIED for clients (allow create: if false).
    //           All contributions MUST be created via the submitContribution
    //           Cloud Function. This prevents bypassing schema validation,
    //           canonical defaults, and immutable audit logging.
    // - Read: Owner OR moderator/admin.
    // - Update: DENIED for all clients. Status, analysis, and moderation fields
    //           are only writable via Admin SDK in Cloud Functions.
    // - Delete: DENIED for all clients.
    // -----------------------------------------------------------------------

    match /contributions/{contributionId} {
      // Disallow direct client creation to force submitContribution backend pipeline
      allow create: if false;

      // Allow owner or moderator to read (supports real-time snapshot listeners in Flutter)
      allow read: if isAuthenticated() &&
        (isContributionOwner(resource.data) || isModerator());

      // Clients may NEVER update or delete contribution documents directly
      allow update: if false;
      allow delete: if false;

      // -----------------------------------------------------------------------
      // contributions/{contributionId}/assets/{assetId}
      // -----------------------------------------------------------------------
      // - Create: DENIED from client. recordAssetUpload callable creates assets
      //           via Admin SDK after client uploads media to Storage.
      // - Read: Owner of parent contribution OR moderator.
      // - Update/Delete: DENIED for all clients (B2 uses Admin SDK).
      // -----------------------------------------------------------------------

      match /assets/{assetId} {
        allow read: if isAuthenticated() &&
          (isContributionOwner(
            get(/databases/$(database)/documents/contributions/$(contributionId)).data
          ) || isModerator());

        // All asset document writes go through Cloud Functions (Admin SDK)
        allow create, update, delete: if false;
      }
    }

    // -----------------------------------------------------------------------
    // audit_logs/{logId}
    // -----------------------------------------------------------------------
    // - Append-only via Admin SDK. No client reads or writes permitted.
    // -----------------------------------------------------------------------

    match /audit_logs/{logId} {
      allow read, write: if false;
    }

    // -----------------------------------------------------------------------
    // Default deny-all — catches any path not explicitly matched above.
    // -----------------------------------------------------------------------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
