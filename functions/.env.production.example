# ==============================================================================
# Cloud Functions Production Environment Configuration Template
# Project: Startup Buildathon India 2026 — InnovoTribe (Neighborhood Guide App)
# Task: A6 — Security, Integration, Deployment and Release
# ==============================================================================
# INSTRUCTIONS:
# - Do NOT insert real API keys, secrets, or private tokens directly into this file.
# - Production secrets marked [SECRET MANAGER] must be provisioned via Google Cloud Secret Manager
#   using the Firebase CLI: `firebase functions:secrets:set <SECRET_NAME>`.
# - Standard runtime configuration variables marked [CONFIG] can be set via Cloud Functions
#   environment variables (.env.production) during deployment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE GCP / FIREBASE PROJECT CONFIGURATION [REQUIRED CONFIG]
# ------------------------------------------------------------------------------
# The Google Cloud / Firebase project identifier where Cloud Functions are deployed.
PROJECT_ID=neighborhoodguideapp-35856

# The default Cloud Storage bucket for local voice notes, spot photos, and offline pack bundles.
FIREBASE_STORAGE_BUCKET=neighborhoodguideapp-35856.firebasestorage.app

# ------------------------------------------------------------------------------
# 2. RUNTIME ENVIRONMENT & FAIL-CLOSED GUARDS [REQUIRED CONFIG]
# ------------------------------------------------------------------------------
# Node runtime environment. Must be set to 'production' in live cloud environments.
NODE_ENV=production

# Payment settlement environment.
# Values: 'LIVE' (production payment rails) or 'SANDBOX' (testing/dev).
# Fail-closed guard: Deployed production environments strictly reject 'SANDBOX' to prevent balance minting.
PAYMENT_ENV=LIVE

# ------------------------------------------------------------------------------
# 3. PRODUCTION SECRETS (GOOGLE CLOUD SECRET MANAGER) [REQUIRED SECRETS]
# ------------------------------------------------------------------------------
# Google Gemini API Key: Required for Gemini 2.5 Flash ingestion, Gemini 3.8 Live,
# and text-embedding-004 preference matching.
# CLI Command: firebase functions:secrets:set GEMINI_API_KEY
# GEMINI_API_KEY=

# Google Maps Platform Server Key: Required for Places API (New) grounding and Routes Directions.
# CLI Command: firebase functions:secrets:set MAPS_API_KEY
# MAPS_API_KEY=

# Razorpay / Live Payment Gateway Key ID: Required for live UPI & pass checkout intent creation.
# CLI Command: firebase functions:secrets:set RAZORPAY_KEY_ID
# RAZORPAY_KEY_ID=

# Razorpay / Live Payment Gateway Key Secret: Required for HMAC-SHA256 signature verification.
# CLI Command: firebase functions:secrets:set RAZORPAY_KEY_SECRET
# RAZORPAY_KEY_SECRET=

# Payment Gateway Webhook Secret: Required for validating inbound webhook notifications.
# CLI Command: firebase functions:secrets:set PAYMENT_WEBHOOK_SECRET
# PAYMENT_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 4. FIREBASE APP CHECK SECURITY [REQUIRED CONFIG]
# ------------------------------------------------------------------------------
# Enforces Firebase App Check verification across callable Cloud Functions.
# Set to 'false' during initial client rollout, transition to 'true' once Play Integrity is verified on devices.
ENFORCE_APP_CHECK=false

# Allows debug tokens in non-production environments. Must be 'false' in production.
APP_CHECK_ALLOW_DEBUG_TOKENS=false

# ------------------------------------------------------------------------------
# 5. AI MODEL REGISTRY & LIMITS (FROZEN ARCHITECTURE) [OPTIONAL CONFIG]
# ------------------------------------------------------------------------------
# Primary server-side model identifier (Frozen commitment: Gemini 3.8 Flash).
GEMINI_DEFAULT_MODEL=gemini-3.8-flash

# High-speed fallback model identifier (Frozen commitment: Gemini 3.5 Flash-Lite).
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Multimodal semantic embedding model (Frozen commitment: Gemini Embedding 2).
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Live bidirectional audio/visual streaming model (Frozen commitment: Gemini 3.8 Live).
GEMINI_LIVE_MODEL=gemini-3.8-live

# Timeout for Gemini API requests in milliseconds (default: 30000ms = 30s).
GEMINI_REQUEST_TIMEOUT_MS=30000

# Maximum retry attempts on transient network or 503 rate-limit errors (default: 3).
GEMINI_MAX_RETRIES=3
