# Cloud Functions Local Environment Configuration
# Copy to .env.local for local Firebase emulator development.
# Never commit real API keys or service account credentials.

# Firebase project configuration
PROJECT_ID=neighborhoodguideapp-35856
FIREBASE_STORAGE_BUCKET=neighborhoodguideapp-35856.firebasestorage.app

# Server-side API credentials
# Replace blank values with valid credentials in your local environment.
GEMINI_API_KEY=
MAPS_API_KEY=

# Gemini model configuration
# Confirm actual API model IDs and project access before using them.
GEMINI_DEFAULT_MODEL=
GEMINI_FALLBACK_MODEL=
GEMINI_EMBEDDING_MODEL=

# Runtime configuration
NODE_ENV=development
GEMINI_REQUEST_TIMEOUT_MS=30000
GEMINI_MAX_RETRIES=3