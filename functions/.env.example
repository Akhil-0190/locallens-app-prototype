# ==============================================================================
# Google Gemini API & Server Environment Configuration
# DO NOT COMMIT SENSITIVE KEYS TO VERSION CONTROL (.gitignore protects .env)
# ==============================================================================

# Primary Gemini API Key obtained from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=

# Default operational model ID (verified responsive API ID, e.g. gemini-3.5-flash-lite or gemini-3.8-flash)
GEMINI_DEFAULT_MODEL=gemini-3.5-flash-lite

# Fallback model ID if primary experiences rate limits or service degradation
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite

# Default embedding model ID (verified API ID)
GEMINI_EMBEDDING_MODEL=gemini-embedding-2

# Environment mode: development, test, or production
NODE_ENV=development

# Request timeout in milliseconds (default: 30000)
GEMINI_REQUEST_TIMEOUT_MS=30000

# Maximum retry attempts on 429/503 errors (default: 3)
GEMINI_MAX_RETRIES=3
